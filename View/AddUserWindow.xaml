<Window x:Class="MemoryGame.View.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New User" Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/MemoryGameIcon.jpg"
        Background="#FFF7F7F7">
    <Grid>
        <Border CornerRadius="10" Background="White" Margin="10" Padding="15"
                BorderBrush="#DDDDDD" BorderThickness="1" Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Enter User Name:" FontSize="16" FontWeight="Bold" 
                           Margin="0,0,0,8" Foreground="#333"/>

                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="6" Margin="0,0,0,15"
                         BorderBrush="#AAA" BorderThickness="1"
                         Background="#FAFAFA" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Content="OK" Width="80" Height="30" 
                            Command="{Binding ConfirmCommand}" 
                            Margin="0,0,8,0"
                            Background="#4CAF50" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Cancel" Width="80" Height="30" 
                            Command="{Binding CancelCommand}" 
                            Background="#F44336" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>


    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="#333" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
    </Window.Resources>
</Window>
