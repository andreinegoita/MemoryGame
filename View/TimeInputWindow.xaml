<Window x:Class="MemoryGame.View.TimeInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Custom Time" Height="200" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Set custom time (minutes:seconds)" FontSize="14" Margin="0,0,0,10" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBox Width="50" Text="{Binding Minutes}" Margin="5"/>
            <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
            <TextBox Width="50" Text="{Binding Seconds}" Margin="5"/>
        </StackPanel>
        <Button Content="Confirm" Width="80" HorizontalAlignment="Center" Command="{Binding ConfirmCommand}"/>
    </StackPanel>
</Window>
